@using ASPIFY_MVC.DTO
@using System.Text.Encodings.Web
@{
    Layout = "_DashLayout";
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Manage Entities - ASPIFY</title>
  <link rel="stylesheet" href="~/css/theme.css">
  <style>
    .content {
      margin-top: 80px;
    }
    .card {
      border: 0;
      box-shadow: 0 1.5625rem 2.8125rem rgb(79 86 101 / .075);
      border-radius: 0.625rem;
      margin-bottom: 2rem;
    }
    .card-title {
      color: #0B132A;
      font-weight: 600;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .btn-success {
      background-color: #2FAB73;
      border-color: #2FAB73;
    }
    .btn-success:hover {
      background-color: #279160;
      border-color: #279160;
    }
    .btn-primary {
      background-color: #387BF5;
      border-color: #387BF5;
    }
    .btn-primary:hover {
      background-color: #2d62c4;
      border-color: #2d62c4;
    }
    .property-box .form-row {
      align-items: center;
    }
    .property-box .close {
      font-size: 24px;
      color: #F53838;
      cursor: pointer;
      margin-left: 10px;
      background: none;
      border: none;
    }
    .property-box, .entity-list-box {
      width: 100%;
      max-height: 300px;
      overflow: auto;
      padding: 1rem;
      box-sizing: border-box;
    }
    .list-group-item a {
      color: #387BF5;
      text-decoration: none;
      font-weight: 500;
    }
    .list-group-item a:hover {
      color: #2d62c4;
      text-decoration: underline;
    }
    .modal-content {
      border-radius: 0.625rem;
      border: 0;
    }
    .modal-header {
      background-color: #F8F8F8;
      border-bottom: 1px solid #bec3d0;
    }
    .form-control:focus, .form-select:focus {
      border-color: #387BF5;
      box-shadow: 0 0 0 0.2rem rgba(56, 123, 245, 0.25);
    }
  </style>
</head>
<body>
  <div class="container">
    <div id="alertMessage" class="alert" role="alert" style="display: none;"></div>

 
   <div class="modal" id="entityDetailsModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Entity Details</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close" onclick="closeEntityDetails()">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p id="entityDetails">
                    <strong>Name:</strong> EntityName<br>
                    <strong>Type:</strong> EntityType<br>
                    <strong>Properties:</strong><br>
                    - Property1: Type1<br>
                    - Property2: Type2<br>
                    - Property3: Type3<br>
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" onclick="closeEntityDetails()" class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

    <!-- Add Entity Form -->
    <div class="card hover-top">
      <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
          <h2 class="card-title mb-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="#387BF5" stroke-width="2" class="me-2">
              <path d="M12 4v16m8-8H4"/>
            </svg>
            Add New Entity
          </h2>
          <a asp-controller="generator" asp-action="entities">
            <button type="button" class="btn btn-success btn-glow" style="border-radius: 0.5rem;">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path d="M12 4v16m8-8H4"/>
              </svg>
            </button>
          </a>
        </div>

        @* V-09 CSRF token for fetch *@
        @Html.AntiForgeryToken()
        <form id="addEntityForm">
          <div class="mb-4">
            <label for="entityName" class="form-label fw-medium">Entity Name</label>
            <input type="text" class="form-control form-control-lg" id="entityName" name="entityName" placeholder="e.g., Customer, Order" pattern="[A-Z][A-Za-z0-9_]{2,50}" title="PascalCase, 3-50 chars, letters/digits/underscore, start uppercase" maxlength="50" required>
            <small class="text-muted" style="font-size: 0.875rem;">Use PascalCase, 3-50 characters (e.g., Customer, OrderItem)</small>
          </div>
          <hr class="my-4">
          <h4 class="mb-3" style="color: #0B132A; font-weight: 600;">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="#2FAB73" stroke-width="2" class="me-2" style="display: inline; vertical-align: middle;">
              <path d="M4 6h16M4 10h16M4 14h16M4 18h16"/>
            </svg>
            Properties
          </h4>
          <div class="property-box bg-light rounded" style="border: 1px solid #bec3d0;">
            <div class="form-group mb-3">
              <div class="form-row g-2">
                <div class="col-md-4">
                  <label for="propertyName" class="form-label small">Property Name</label>
                  <input type="text" class="form-control" id="propertyName" name="p1" placeholder="e.g., Id" pattern="[A-Za-z][A-Za-z0-9_]{0,49}" maxlength="50">
                </div>
                <div class="col-md-4">
                  <label for="propertyType" class="form-label small">Property Type</label>
                  <select class="form-select" id="propertyType" name="p1Type">
                    <option value="String">String</option>
                    <option value="int">Integer</option>
                    <option value="double">Double</option>
                    <option value="Boolean">Boolean</option>
                    <option value="DateTime">DateTime</option>
                    <option value="Point">Point</option>
                  </select>
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="isPrimaryKey" name="p1PrimaryKey">
                        <label class="form-check-label small" for="isPrimaryKey">Primary Key</label>
                    </div>
                </div>
              </div>
            </div>
          </div>
          <div class="mt-4 d-flex gap-2">
            <button type="button" class="btn btn-primary" onclick="addProperty()">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="vertical-align: middle; margin-right: 4px;">
                <path d="M12 4v16m8-8H4"/>
              </svg>
              Add Property
            </button>
            <button type="button" class="btn btn-success btn-glow" onclick="addEntity()">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="vertical-align: middle; margin-right: 4px;">
                <path d="M5 13l4 4L19 7"/>
              </svg>
              Create Entity
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- List of Existing Entities -->
    <div class="card hover-top">
      <div class="card-body entity-list-box p-4">
        <h2 class="card-title mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="#387BF5" stroke-width="2" class="me-2">
            <path d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
          </svg>
          Existing Entities
        </h2>
        <ul id="entityList" class="list-group list-group-flush">
              @{if (ViewBag.Entities == null)
                  ViewBag.Entities = new List<Entity>();
               }
              @if (ViewBag.Entities.Count == 0)
              {
                  <li class="list-group-item text-center py-4 text-muted">
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="none" viewBox="0 0 24 24" stroke="#bec3d0" stroke-width="1.5" class="mb-2">
                      <path d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                    </svg>
                    <p class="mb-0">No entities created yet. Start by adding your first entity above.</p>
                  </li>
              }
              else
              {
                  @foreach (var entity in ViewBag.Entities)
                  {
                      @* V-04 FIX: encode for JS context, use data-attribute, and encode delete link *@
                      <li class="list-group-item d-flex justify-content-between align-items-center py-3" style="border-bottom: 1px solid #f1f1f1;">
                          <div>
                              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="#2FAB73" stroke-width="2" class="me-2" style="display: inline; vertical-align: middle;">
                                <path d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                              </svg>
                              <a href="javascript:void(0)" data-entity-name="@entity.Name" onclick="showEntityDetails(this.dataset.entityName)" class="fw-medium">@Html.Encode(entity.Name)</a>
                          </div>
                          @* V-09 FIX: use POST form with antiforgery, not GET link *@
                          <form method="post" action="@Url.Action("RemoveEntity", "Generator", new { name = entity.Name })" style="display:inline;" onsubmit="return confirm('Delete @Html.Encode(entity.Name)?')">
                              @Html.AntiForgeryToken()
                              <button type="submit" class="btn btn-sm" style="background:none;border:none;color:#F53838;padding:0.25rem;" title="Delete entity" aria-label="Delete @Html.Encode(entity.Name)">
                                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                  </svg>
                              </button>
                          </form>
                      </li>
                  }
              }
        </ul>
      </div>
    </div>
  </div>

  <script>
    // V-04 FIX: use DOMPurify or textContent - load DOMPurify if available
    function addProperty() {
      var propertyBox = document.querySelector(".property-box");
      var propertyCount = propertyBox.querySelectorAll(".form-group").length;
      var newProperty = document.createElement("div");
      newProperty.className = "form-group";
      // Use textContent-safe template - no innerHTML with user data
      var row = document.createElement("div");
      row.className = "form-row";
      row.innerHTML = `
        <div class="col">
          <label>Property Name:</label>
          <input type="text" class="form-control" name="p${propertyCount + 1}" placeholder="Enter property name" pattern="[A-Za-z][A-Za-z0-9_]{0,49}" maxlength="50">
        </div>
        <div class="col">
          <label>Property Type:</label>
          <select class="form-control" name="p${propertyCount + 1}Type">
            <option value="String">String</option>
            <option value="int">Integer</option>
            <option value="double">Double</option>
            <option value="Boolean">Boolean</option>
            <option value="DateTime">DateTime</option>
            <option value="Point">Point</option>
          </select>
        </div>
        <div class="col-md3" style="display: none;">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="p${propertyCount + 1}PrimaryKey" >
                        <label class="form-check-label">Primary Key</label>
                    </div>
                </div>
          <button type="button" class="close" aria-label="Close" onclick="removeProperty(this)">
            <span aria-hidden="true">&times;</span>
          </button>
      `;
      // row's innerHTML is static template only (no user data), safe
      newProperty.appendChild(row);
      propertyBox.appendChild(newProperty);
    }

    function removeProperty(button) {
      var propertyBox = document.querySelector(".property-box");
      propertyBox.removeChild(button.closest(".form-group"));
    }

    // V-02 client side validation + V-09 antiforgery header
    function sendForm() {
      var entityName = document.getElementById("entityName").value.trim();
      if (!entityName) {
        showAlert("Entity name is required.", "alert-danger");
        return;
      }
      // Strict allowlist matches server ValidationService
      if (!/^[A-Z][A-Za-z0-9_]{2,50}$/.test(entityName)) {
        showAlert("Invalid entity name. Use PascalCase 3-50 chars.", "alert-danger");
        return;
      }

      var properties = [];
      var propertyBox = document.querySelector(".property-box");
      var propertyCount = propertyBox.querySelectorAll(".form-group").length;
      for (var j = 0; j < propertyCount; j++) {
        var nameInput = document.querySelector(`input[name=p${j + 1}]`);
        var typeSelect = document.querySelector(`select[name=p${j + 1}Type]`);
        var pkInput = document.querySelector(`input[name=p${j + 1}PrimaryKey]`);
        if (!nameInput || !typeSelect) continue;
        var propertyName = nameInput.value.trim();
        var propertyType = typeSelect.value;
        if (!propertyName) {
            showAlert("Property name is required for property " + (j+1), "alert-danger");
            return;
        }
        if (!/^[A-Za-z][A-Za-z0-9_]{0,49}$/.test(propertyName)) {
            showAlert("Invalid property name: " + propertyName, "alert-danger");
            return;
        }
        properties.push({ name: propertyName, type: propertyType, isPk: pkInput ? pkInput.checked : false});
      }
      if (properties.length === 0) {
        showAlert("At least one property required", "alert-danger");
        return;
      }

      var entity = {
        name: entityName,
        properties: properties
      };

      // V-09: get antiforgery token
      var tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
      var token = tokenInput ? tokenInput.value : "";
      fetch("/generator/add-entity", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "X-XSRF-TOKEN": token // matches Program.cs HeaderName configuration
        },
        body: JSON.stringify(entity)
      })
        .then(async response => {
          if (response.ok) {
            showAlert("Entity added successfully!", "alert-success");
            window.location.reload();   
            return response.json();
          } else {
            var err = await response.text();
            showAlert("Error: " + err, "alert-danger");
            throw new Error(err);
          }
        })
        .then(data => console.log(data))
        .catch(error => console.error("Error:", error));
    }

    function showAlert(message, alertClass) {
      var alertDiv = document.getElementById("alertMessage");
      alertDiv.className = `alert ${alertClass}`;
      alertDiv.textContent = message; // V-04 FIX: textContent not innerHTML
      alertDiv.style.display = "block";
      setTimeout(() => {
        alertDiv.style.display = "none";
      }, 3000);
    }

    function addEntity() {
      var entityName = document.getElementById("entityName").value;
      if (entityName.trim() !== "") {
        // Don't add to list optimistically - wait for server success
        sendForm();
        // document.getElementById("addEntityForm").reset(); // reset after success in sendForm
      } else {
        showAlert("Entity name required", "alert-danger");
      }
    }

    // V-04 FIX: Use textContent, not innerHTML
    function showEntityDetails(entityName) {
      // Validate entityName client side
      if (!/^[A-Za-z0-9_]{2,50}$/.test(entityName)) {
        showAlert("Invalid entity name", "alert-danger");
        return;
      }
      fetch(`/generator/entities/${encodeURIComponent(entityName)}`)
        .then(response => {
            if (!response.ok) throw new Error("Not found");
            return response.json();
        })
        .then(data => {
          var entityDetails = document.getElementById("entityDetails");
          // Clear safely
          entityDetails.textContent = "";
          
          var nameStrong = document.createElement("strong");
          nameStrong.textContent = "Name: ";
          entityDetails.appendChild(nameStrong);
          var nameSpan = document.createElement("span");
          nameSpan.textContent = data.name;
          entityDetails.appendChild(nameSpan);
          entityDetails.appendChild(document.createElement("br"));

          var propStrong = document.createElement("strong");
          propStrong.textContent = "Properties:";
          entityDetails.appendChild(propStrong);
          entityDetails.appendChild(document.createElement("br"));

          if (data.properties && Array.isArray(data.properties)) {
            data.properties.forEach(property => {
                var div = document.createElement("div");
                // textContent ensures XSS payload is rendered as text, not executed
                div.textContent = `- ${property.name}: ${property.type}` + (property.isPk ? " (PK)" : "");
                entityDetails.appendChild(div);
            });
          }
          $('#entityDetailsModal').modal('show');
        })
        .catch(error => console.error("Error:", error));
    }
   
    function closeEntityDetails() {
      $('#entityDetailsModal').modal('hide');
    }
  </script>
</body>
</html>
