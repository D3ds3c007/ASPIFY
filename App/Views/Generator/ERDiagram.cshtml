@using ASPIFY_MVC.DTO
@{
    Layout = "_DashLayout";
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ER Diagram - ASPIFY</title>
  <link rel="stylesheet" href="~/css/theme.css">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/cytoscape/3.26.0/cytoscape.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/dagre/0.8.5/dagre.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/cytoscape-dagre/2.5.0/cytoscape-dagre.min.js"></script>
  <style>
    .content {
      margin-top: 80px;
    }
    .card {
      border: 0;
      box-shadow: 0 1.5625rem 2.8125rem rgb(79 86 101 / .075);
      border-radius: 0.625rem;
      margin-bottom: 2rem;
    }
    .card-title {
      color: #0B132A;
      font-weight: 600;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .btn-primary {
      background-color: #387BF5;
      border-color: #387BF5;
    }
    .btn-primary:hover {
      background-color: #2d62c4;
      border-color: #2d62c4;
    }
    .btn-success {
      background-color: #2FAB73;
      border-color: #2FAB73;
    }
    .btn-success:hover {
      background-color: #279160;
      border-color: #279160;
    }
    #cy {
      width: 100%;
      height: 600px;
      border: 1px solid #bec3d0;
      border-radius: 0.625rem;
      background: #fafafa;
    }
    .diagram-controls {
      margin-bottom: 1rem;
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
    }
    .entity-node {
      background: #fff;
      border: 2px solid #387BF5;
      border-radius: 8px;
      padding: 10px;
      min-width: 150px;
      text-align: center;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    .entity-label {
      font-weight: 600;
      color: #0B132A;
      font-size: 14px;
    }
    .property-list {
      font-size: 11px;
      color: #4A5568;
      margin-top: 5px;
      text-align: left;
    }
    .relationship-edge {
      width: 2px;
      line-color: #2FAB73;
      target-arrow-color: #2FAB73;
      target-arrow-shape: triangle;
      curve-style: bezier;
    }
    .modal-content {
      border-radius: 0.625rem;
      border: 0;
    }
    .modal-header {
      background-color: #F8F8F8;
      border-bottom: 1px solid #bec3d0;
    }
    .alert {
      border-radius: 0.625rem;
      margin-bottom: 1rem;
    }
  </style>
</head>
<body>
  <div class="container">
    <div id="alertMessage" class="alert" role="alert" style="display: none;"></div>

    <!-- ER Diagram Canvas -->
    <div class="card hover-top">
      <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
          <h2 class="card-title mb-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="#387BF5" stroke-width="2" class="me-2">
              <path d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h4a1 1 0 011 1v6a1 1 0 01-1 1h-4a1 1 0 01-1-1v-6z"/>
            </svg>
            Interactive ER Diagram
          </h2>
          <div class="diagram-controls">
            <button type="button" class="btn btn-primary btn-glow" onclick="refreshDiagram()">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="vertical-align: middle; margin-right: 4px;">
                <path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
              </svg>
              Refresh
            </button>
            <button type="button" class="btn btn-primary btn-glow" onclick="autoLayout()">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="vertical-align: middle; margin-right: 4px;">
                <path d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h4a1 1 0 011 1v6a1 1 0 01-1 1h-4a1 1 0 01-1-1v-6z"/>
              </svg>
              Auto Layout
            </button>
            <button type="button" class="btn btn-success btn-glow" onclick="zoomIn()">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/>
              </svg>
            </button>
            <button type="button" class="btn btn-success btn-glow" onclick="zoomOut()">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM13 10H7"/>
              </svg>
            </button>
            <button type="button" class="btn btn-success btn-glow" onclick="fitDiagram()">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/>
              </svg>
            </button>
          </div>
        </div>

        <div id="cy"></div>
        
        <div class="mt-4">
          <p class="text-muted small">
            <strong>Instructions:</strong> Drag nodes to reposition. Click on a node to view details. Scroll to zoom. Use auto-layout for optimal arrangement.
          </p>
        </div>
      </div>
    </div>

    <!-- Entity Details Modal -->
    <div class="modal" id="entityDetailsModal" tabindex="-1" role="dialog">
      <div class="modal-dialog" role="document">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title">Entity Details</h5>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close" onclick="closeEntityDetails()">
              <span aria-hidden="true">&times;</span>
            </button>
          </div>
          <div class="modal-body" id="entityDetailsBody">
            <!-- Content will be populated dynamically -->
          </div>
          <div class="modal-footer">
            <button type="button" onclick="closeEntityDetails()" class="btn btn-secondary" data-dismiss="modal">Close</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    var cy;
    var entitiesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.Entities ?? new List<Entity>()));
    var relationshipsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.Relationships ?? new List<Relationship>()));

    document.addEventListener('DOMContentLoaded', function() {
      initCytoscape();
    });

    function initCytoscape() {
      cy = cytoscape({
        container: document.getElementById('cy'),
        elements: buildElements(),
        style: [
          {
            selector: 'node',
            style: {
              'background-color': '#fff',
              'border-width': 2,
              'border-color': '#387BF5',
              'label': 'data(label)',
              'text-valign': 'top',
              'text-halign': 'center',
              'text-wrap': 'wrap',
              'text-max-width': '150px',
              'font-size': '12px',
              'font-weight': '600',
              'color': '#0B132A',
              'width': 'label',
              'height': 'label',
              'padding': '10px',
              'shape': 'round-rectangle',
              'text-background-color': '#fff',
              'text-background-opacity': 1,
              'text-background-shape': 'round-rectangle'
            }
          },
          {
            selector: 'node:selected',
            style: {
              'border-color': '#2FAB73',
              'border-width': 3,
              'shadow-blur': 10,
              'shadow-color': '#2FAB73',
              'shadow-opacity': 0.5
            }
          },
          {
            selector: 'edge',
            style: {
              'width': 2,
              'line-color': '#2FAB73',
              'target-arrow-color': '#2FAB73',
              'target-arrow-shape': 'triangle',
              'curve-style': 'bezier',
              'label': 'data(label)',
              'font-size': '10px',
              'text-rotation': 'autorotate',
              'text-margin-y': -10
            }
          }
        ],
        layout: {
          name: 'dagre',
          rankDir: 'TB',
          animate: true,
          animationDuration: 500
        },
        wheelSensitivity: 0.3,
        boxSelectionEnabled: true,
        selectionType: 'single'
      });

      // Node click event
      cy.on('tap', 'node', function(evt) {
        var node = evt.target;
        var entityName = node.data('id');
        showEntityDetails(entityName);
      });

      // Edge click event
      cy.on('tap', 'edge', function(evt) {
        var edge = evt.target;
        showAlert('Relationship: ' + edge.data('label'), 'alert-info');
      });
    }

    function buildElements() {
      var elements = [];
      
      // Add nodes for entities
      if (entitiesData && entitiesData.length > 0) {
        entitiesData.forEach(function(entity) {
          var propertiesText = '';
          if (entity.properties && entity.properties.length > 0) {
            propertiesText = entity.properties.map(function(p) {
              return p.name + ': ' + p.type + (p.isPk ? ' (PK)' : '');
            }).join('\\n');
          }
          
          elements.push({
            data: {
              id: entity.name,
              label: entity.name + '\\n' + propertiesText,
              entityType: 'entity',
              properties: entity.properties
            },
            position: { x: 0, y: 0 }
          });
        });
      }
      
      // Add edges for relationships
      if (entitiesData && entitiesData.length > 0) {
        entitiesData.forEach(function(entity) {
          if (entity.relationships && entity.relationships.length > 0) {
            entity.relationships.forEach(function(rel, index) {
              var edgeId = entity.name + '-' + rel.relationName + '-' + index;
              elements.push({
                data: {
                  id: edgeId,
                  source: entity.name,
                  target: rel.targetEntity,
                  label: rel.type + '\\n' + rel.relationName,
                  relationshipType: rel.type,
                  relationName: rel.relationName
                }
              });
            });
          }
        });
      }
      
      return elements;
    }

    function refreshDiagram() {
      location.reload();
    }

    function autoLayout() {
      if (cy) {
        var layout = cy.layout({
          name: 'dagre',
          rankDir: 'TB',
          animate: true,
          animationDuration: 500
        });
        layout.run();
      }
    }

    function zoomIn() {
      if (cy) {
        cy.zoom({
          level: cy.zoom() * 1.2,
          renderedPosition: { x: cy.width() / 2, y: cy.height() / 2 }
        });
      }
    }

    function zoomOut() {
      if (cy) {
        cy.zoom({
          level: cy.zoom() * 0.8,
          renderedPosition: { x: cy.width() / 2, y: cy.height() / 2 }
        });
      }
    }

    function fitDiagram() {
      if (cy) {
        cy.fit(null, 50);
        cy.center();
      }
    }

    function showEntityDetails(entityName) {
      var entity = entitiesData.find(function(e) { return e.name === entityName; });
      if (!entity) return;

      var detailsHtml = '<div class="entity-node" style="border: 2px solid #387BF5; text-align: left;">';
      detailsHtml += '<h4 style="color: #0B132A; margin-bottom: 10px;">' + escapeHtml(entity.name) + '</h4>';
      detailsHtml += '<strong>Properties:</strong><br>';
      
      if (entity.properties && entity.properties.length > 0) {
        entity.properties.forEach(function(prop) {
          detailsHtml += '<div style="padding: 5px 0; border-bottom: 1px solid #f1f1f1;">';
          detailsHtml += '<strong>' + escapeHtml(prop.name) + '</strong>: ' + escapeHtml(prop.type);
          if (prop.isPk) {
            detailsHtml += ' <span class="badge" style="background-color: #387BF5; color: white; padding: 2px 6px; border-radius: 4px; font-size: 10px;">PK</span>';
          }
          detailsHtml += '</div>';
        });
      } else {
        detailsHtml += '<p class="text-muted">No properties defined</p>';
      }

      if (entity.relationships && entity.relationships.length > 0) {
        detailsHtml += '<br><strong>Relationships:</strong><br>';
        entity.relationships.forEach(function(rel) {
          detailsHtml += '<div style="padding: 5px 0; border-bottom: 1px solid #f1f1f1;">';
          detailsHtml += escapeHtml(rel.type) + ' → ' + escapeHtml(rel.targetEntity);
          detailsHtml += ' <small class="text-muted">(' + escapeHtml(rel.relationName) + ')</small>';
          detailsHtml += '</div>';
        });
      }

      detailsHtml += '</div>';

      document.getElementById('entityDetailsBody').innerHTML = detailsHtml;
      document.getElementById('entityDetailsModal').style.display = 'block';
      document.getElementById('entityDetailsModal').classList.add('show');
    }

    function closeEntityDetails() {
      document.getElementById('entityDetailsModal').style.display = 'none';
      document.getElementById('entityDetailsModal').classList.remove('show');
    }

    function escapeHtml(text) {
      if (!text) return '';
      var div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    function showAlert(message, type) {
      var alertDiv = document.getElementById('alertMessage');
      alertDiv.textContent = message;
      alertDiv.className = 'alert ' + type;
      alertDiv.style.display = 'block';
      setTimeout(function() {
        alertDiv.style.display = 'none';
      }, 5000);
    }

    // Close modal when clicking outside
    window.onclick = function(event) {
      var modal = document.getElementById('entityDetailsModal');
      if (event.target == modal) {
        closeEntityDetails();
      }
    }
  </script>
</body>
</html>
