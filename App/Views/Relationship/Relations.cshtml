@using ASPIFY_MVC.DTO
@{
    Layout = "_DashLayout";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Relationships - ASPIFY</title>
    <link rel="stylesheet" href="~/css/theme.css">
    <style>
        .content {
            margin-top: 80px;
        }
        .card {
            border: 0;
            box-shadow: 0 1.5625rem 2.8125rem rgb(79 86 101 / .075);
            border-radius: 0.625rem;
            margin-bottom: 2rem;
        }
        .card-title {
            color: #0B132A;
            font-weight: 600;
            display: flex;
            align-items: center;
        }
        .btn-success {
            background-color: #2FAB73;
            border-color: #2FAB73;
        }
        .btn-success:hover {
            background-color: #279160;
            border-color: #279160;
        }
        .form-control:focus, .form-select:focus {
            border-color: #387BF5;
            box-shadow: 0 0 0 0.2rem rgba(56, 123, 245, 0.25);
        }
        .list-group-item {
            border-bottom: 1px solid #f1f1f1;
        }
        .list-group-item a {
            color: #387BF5;
            text-decoration: none;
            font-weight: 500;
        }
        .list-group-item a:hover {
            color: #2d62c4;
            text-decoration: underline;
        }
    </style>
</head>
<body>
    <div class="container">
        <div id="alertMessage" class="alert" role="alert" style="display: none;"></div>

        <div class="card hover-top">
            <div class="card-body p-4">
                <h2 class="card-title mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="#387BF5" stroke-width="2" class="me-2">
                        <path d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
                    </svg>
                    Create Entity Relationship
                </h2>
                @Html.AntiForgeryToken()
                <form id="createRelationshipForm">
                    <div class="mb-3">
                        <label for="sourceEntity" class="form-label fw-medium">Source Entity</label>
                        <select class="form-select form-select-lg" id="sourceEntity" name="sourceEntity">
                            @{
                                foreach(Entity entity in ViewBag.Entities)
                                {
                                    <option value="@Html.Encode(entity.Name)">@Html.Encode(entity.Name)</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="targetEntity" class="form-label fw-medium">Target Entity</label>
                        <select class="form-select form-select-lg" id="targetEntity" name="targetEntity">
                             @{
                                foreach(Entity entity in ViewBag.Entities)
                                {
                                    <option value="@Html.Encode(entity.Name)">@Html.Encode(entity.Name)</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="mb-4">
                        <label for="relationshipType" class="form-label fw-medium">Relationship Type</label>
                        <select class="form-select form-select-lg" id="relationshipType" name="relationshipType">
                            <option value="OneToOne">One-to-One</option>
                            <option value="OneToMany">One-to-Many</option>
                            <option value="ManyToOne">Many-to-One</option>
                            <option value="ManyToMany">Many-to-Many</option>
                        </select>
                    </div>
                    <button type="button" class="btn btn-success btn-glow btn-lg" onclick="createRelationship()" style="border-radius: 0.5rem;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="vertical-align: middle; margin-right: 6px;">
                            <path d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
                        </svg>
                        Create Relationship
                    </button>
                </form>
            </div>
        </div>

        <div class="card hover-top">
            <div class="card-body p-4">
                <h2 class="card-title mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="#387BF5" stroke-width="2" class="me-2">
                        <path d="M17 14v7m-3-3h6M6 10h2a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v2a2 2 0 002 2zm10 0h2a2 2 0 002-2V6a2 2 0 00-2-2h-2a2 2 0 00-2 2v2a2 2 0 002 2zM6 20h2a2 2 0 002-2v-2a2 2 0 00-2-2H6a2 2 0 00-2 2v2a2 2 0 002 2z"/>
                    </svg>
                    Existing Relationships
                </h2>
                <ul id="relationshipList" class="list-group list-group-flush">
                    @{if (ViewBag.Relationships == null || ViewBag.Relationships.Count == 0)}
                    {
                        <li class="list-group-item text-center py-4 text-muted">
                            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="none" viewBox="0 0 24 24" stroke="#bec3d0" stroke-width="1.5" class="mb-2">
                                <path d="M17 14v7m-3-3h6M6 10h2a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v2a2 2 0 002 2zm10 0h2a2 2 0 002-2V6a2 2 0 00-2-2h-2a2 2 0 00-2 2v2a2 2 0 002 2zM6 20h2a2 2 0 002-2v-2a2 2 0 00-2-2H6a2 2 0 00-2 2v2a2 2 0 002 2z"/>
                            </svg>
                            <p class="mb-0">No relationships created yet. Define your first relationship above.</p>
                        </li>
                    }
                    else
                    {
                        @foreach(Relationship relationship in ViewBag.Relationships)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                                <div>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="#2FAB73" stroke-width="2" class="me-2" style="display: inline; vertical-align: middle;">
                                        <path d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
                                    </svg>
                                    <a href="#" class="fw-medium">@Html.Encode($"{relationship.relationName}") <span class="badge bg-light text-dark ms-2">@Html.Encode(relationship.type)</span></a>
                                </div>
                                @* V-09 FIX: POST not GET, with antiforgery *@
                                <form method="post" action="@Url.Action("RemoveRelationship", "Relationship", new { relationName = relationship.relationName })" style="display:inline;" onsubmit="return confirm('Delete relationship @Html.Encode(relationship.relationName)?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm" style="background:none;border:none;color:#F53838;padding:0.25rem;" title="Delete relationship" aria-label="Delete @Html.Encode(relationship.relationName)">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                            <path d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                        </svg>
                                    </button>
                                </form>
                            </li>
                        }
                    }
                </ul>
            </div>
        </div>
    </div>

    <script>
        function createRelationship() {
            var sourceEntity = document.getElementById("sourceEntity").value;
            var targetEntity = document.getElementById("targetEntity").value;
            var relationshipType = document.getElementById("relationshipType").value;

            if (sourceEntity === targetEntity) {
                showAlert("Source and target must differ", "alert-danger");
                return;
            }

            var relationship = {
                SourceEntity: sourceEntity,
                TargetEntity: targetEntity,
                Type: relationshipType
            };

            var tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            var token = tokenInput ? tokenInput.value : "";

            fetch("/relationship/add-relationship", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "RequestVerificationToken": token
                },
                body: JSON.stringify(relationship)
            })
            .then(async response => {
                if (response.ok) {
                    showAlert("Relationship created successfully!", "alert-success");
                    window.location.reload();   
                    return response.json();
                } else {
                    var err = await response.text();
                    showAlert("Error: " + err, "alert-danger");
                    throw new Error(err);
                }
            })
            .then(data => console.log(data))
            .catch(error => console.error("Error:", error));
        }

        function showAlert(message, alertClass) {
            var alertDiv = document.getElementById("alertMessage");
            alertDiv.className = `alert ${alertClass}`;
            alertDiv.textContent = message; // textContent, not innerHTML
            alertDiv.style.display = "block";
            setTimeout(() => {
                alertDiv.style.display = "none";
            }, 3000);
        }
    </script>
</body>
</html>
