{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.RateLimiting": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Security": {
    "RequireHttps": true,
    "MaxEntityNameLength": 50,
    "MaxPropertiesPerEntity": 50,
    "MaxXmlFileSizeBytes": 2000000
  }
}
